# Copy to .env; do not commit real credentials.
APP_ENV=production
RUST_LOG=info
HOST=0.0.0.0
PORT=18080
PUBLIC_BASE_URL=https://agentmail.michaelsun.top
OWNER_EMAIL=owner@example.com
PERSONAL_USE_USER_LIMIT=90
AUDIT_RETENTION_DAYS=30
DATABASE_URL=sqlite:///var/lib/agentmail/agentmail.db
GOOGLE_LOGIN_CLIENT_ID=replace.apps.googleusercontent.com
GOOGLE_GMAIL_CLIENT_ID=replace.apps.googleusercontent.com
AGENTMAIL_SECRETS_DIR=./secrets
AGENTMAIL_BACKUP_DIR=./backups
LOGIN_CLIENT_SECRET_FILE=/run/secrets/login_client_secret
GMAIL_CLIENT_SECRET_FILE=/run/secrets/gmail_client_secret
CREDENTIAL_ENCRYPTION_KEYRING_FILE=/run/secrets/credential_encryption_keyring
SESSION_CSRF_SECRET_FILE=/run/secrets/session_csrf_secret
